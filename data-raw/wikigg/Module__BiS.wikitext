--<nowiki>
local p = {}

local embed_template = [=[{|class="BiS"
| colspan="2" | %s
|-
| Spells
| %s %s
|-
| Score
| %s
|-
| Command
| style="background-color: #222;" | %s
%s
|-
| colspan="2" | ''Don't know what this is? Read the [[BiS_Guide|BiS Guide]].''
|}]=]

function p.Embed(frame)
    local raw_data = frame.args[1]
    local command, raw_score, formula, class, pet, pet2, enchants, spells, spellcodes, passives, elixir, stance = p.Import(raw_data)
    
    header = Header(class, pet, pet2)
    spell_set = SpellSet(spells)
    
    spell_codes = SpellCodes(spellcodes, spells)
    other = Other(spell_codes, passives, elixir, stance)
    score = Score(raw_score)
    enchant_rows = EnchantRows(enchants)
        
    return frame:preprocess(string.format(embed_template,
        header, spell_set, other, score, command, enchant_rows
    ))
end

function p.Import(raw)
    local command = ''
    local score = ''
    local formula = ''
    local class = ''
    local pet = ''
    local pet2 = ''
    local spells = {}
    local spellcodesflag  = False
    local passives = {}
    local elixir = ''
    local stance = ''
    local enchants = {}
    
    for line, _ in raw:gmatch"([^\r\n]*)([\r\n]*)" do
        for info, infodata in line:gmatch"([^:]*):(.*)" do
            if info == "Command" then command = infodata end
            if info == "Formula" then formula = infodata end
            if info == "Class" then class = infodata end
            if info == "Pet" then pet = infodata end
            if info == "Pet2" then pet2 = infodata end
            if info == "Score" then score = infodata end
            if info == "Spells" then
                for spell in infodata:gmatch"([^,]+)" do
                    spells[#spells+1] = spell
                end
            end
            if info == "Spellcodes" then spellcodesflag = infodata end
            if info == "Passive" then
                for passive in infodata:gmatch"([^,]+)" do
                    passives[#passives+1] = passive
                end
            end
            if info == "Elixir" then elixir = infodata end
            if info == "Stance" then stance = infodata end
            
            if info == "Enchant" then
                for elvl, edata in infodata:gmatch"([^>]*)>(.*)" do
                    local items = {}
                    for item in edata:gmatch"([^,]*)" do
                        -- :gsub("^.(.*).$", "%1")
                        for slot, name in item:gsub("^.(.*).$", "%1"):gmatch"([^|]*)#(.*)" do
                            items[#items+1] = {slot, name}
                        end
                    end
                    enchants[#enchants+1] = {elvl, items}
                end
            end
        end
    end
    
    return command, score, formula, class, pet, pet2, enchants, spells, spellcodesflag, passives, elixir, stance
end

function Header(class, pet, pet2)
    header = "{{BiSHeader"
    if pet2 ~= "" then
        header = header .. "|pet2=" .. pet2
    end    
    if class ~= "" then
        header = header .. "|class=" .. class
    end
    if pet ~= "" then
        header = header .. "|pet=" .. pet
    end
    return header .. "}}"
end

function SpellSet(spells)
    spell_set = '{{SpellSet'
    
    -- Repeat for each spell
    for num, spell in ipairs(spells) do
        spell_set = spell_set .. string.format('|spell_%s_name=%s', num, spell)
    end
    
    spell_set = spell_set .. '}}'
    return spell_set
end

function SpellCodes(spellcodesflag, spells)
    if not spellcodesflag then return '' end
    	
    spell_codes = '{{SpellCodes'
    
    -- Repeat for each spell
    for num, spell in ipairs(spells) do
        spell_codes = spell_codes .. string.format('|spell_%s_name=%s', num, spell)
    end
    
    spell_codes = spell_codes .. '}}'
    return spell_codes
end

local other_row = [=[
|-
| %s
| %s
]=]

local elixirs = {
    ["Evocation"] = "Evocation Elixir (Increases evocation efficiency)",
    ["Summoning"] = "Summoning Elixir (Increases summoning efficiency)",
    ["Pet"] = "Pet Elixir (Increases Pet Ability Power)",
    ["Shadow"] = "Shadow Elixir (Increases Liquid Shadow generation)",
}

local stances = {
    ["Meditation"] = "Meditation Stance (Charges non-shard spells)",
    ["Defence"] = "Defence Stance (Reduces incantation spell's duration)",
    ["Berserk"] = "Berserk Stance (Increases evocation efficiency)",
}

function Other(spellcodes, passives, elixir, stance)
    other = ""
    if spellcodes ~= "" then
        other = other .. string.format(other_row, "Spellcodes", spellcodes)
    end
    if #passives > 0 then
        passives_string = ""
        for _, passive in pairs(passives) do
            if _ > 1 then
                passives_string = passives_string .. ", "
            end
            passives_string = passives_string .. "{{SpellTooltip|spell_name=" .. passive .. "}}"
        end 
        other = other .. string.format(other_row, "Passives", passives_string)
    end
    
    if elixir ~= "" then
        if elixirs[elixir] == nil then
            other = other .. string.format(other_row, "Elixir", elixir)
        else
            other = other .. string.format(other_row, "Elixir", elixirs[elixir])
        end
    end
    
    if stance ~= "" then
        if stances[stance] == nil then
            other = other .. string.format(other_row, "Stance", stance)
        else
            other = other .. string.format(other_row, "Stance", stances[stance])
        end
    end
    
    return other
end

