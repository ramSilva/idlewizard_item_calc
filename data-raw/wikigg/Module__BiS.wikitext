function Score(raw_score)
    if scores[raw_score] == nil then
        return raw_score
    else
        return scores[raw_score]
    end
end

local enchant_row = [=[
|- class="enchant-row"
| Enchant %s
| {{ItemPreset|head_name=%s|hands_name=%s|chest_name=%s|boots_name=%s|shoulder_name=%s|neck_name=%s|waist_name=%s|wrist_name=%s|back_name=%s|weapon_name=%s|offhand_name=%s|ring1_name=%s|ring2_name=%s|research_name=%s|trophy1_name=%s|trophy2_name=%s|pants_name=%s}}]=]

function EnchantRows(enchant_levels)
    enchant_rows = ''

    -- enchant_levels is a table
    -- enchant_levels[1] = { 0, { { "Head", "Emp HG" }, { "Hands", "Fiery Grips" }, ... } }
    -- so enchants[1][1] is the table with items of the first enchant
    for _, enchdata in pairs(enchant_levels) do
        lvl = {}
        enchlvl = enchdata[1]
        for _, item in pairs(enchdata[2]) do
            lvl[item[1]] = item[2]
        end
        
        -- Enchant level, head, hands, chest, boots, shoulder, neck, waist, wrist, back, weapon, ring1, ring2
        enchant_rows = enchant_rows .. string.format(enchant_row,
            enchlvl, 
            lvl['Head'] ~= nil and lvl['Head'] or '', 
            lvl['Hands'] ~= nil and lvl['Hands'] or '', 
            lvl['Chest'] ~= nil and lvl['Chest'] or '', 
            lvl['Boots'] ~= nil and lvl['Boots'] or '', 
            lvl['Shoulder'] ~= nil and lvl['Shoulder'] or '', 
            lvl['Neck'] ~= nil and lvl['Neck'] or '', 
            lvl['Waist'] ~= nil and lvl['Waist'] or '', 
            lvl['Wrist'] ~= nil and lvl['Wrist'] or '', 
            lvl['Back'] ~= nil and lvl['Back'] or '', 
            lvl['Weapon'] ~= nil and lvl['Weapon'] or '', 
            lvl['Offhand'] ~= nil and lvl['Offhand'] or '', 
            lvl['Ring1'] ~= nil and lvl['Ring1'] or '', 
            lvl['Ring2'] ~= nil and lvl['Ring2'] or '',
            lvl['Research'] ~= nil and lvl['Research'] or '',
            lvl['Trophy1'] ~= nil and lvl['Trophy1'] or '',
            lvl['Trophy2'] ~= nil and lvl['Trophy2'] or '',
            lvl['Pants'] ~= nil and lvl['Pants'] or ''
        )
    end
    
    return enchant_rows
end

return p

