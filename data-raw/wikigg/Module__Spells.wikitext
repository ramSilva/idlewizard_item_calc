-- Used on GameID Page
function p.IDList(frame)
	local spells = SpellList()

	local table = mw.html.create('table')
		:addClass('sortable')
		:addClass('wikitable')
		:attr('id', 'Spells')

	local header = table:tag('tr')

	header:tag('th')
		:attr('colspan', '2')
		:wikitext('Spells')

	local row = table:tag('tr')

	row:tag('th')
		:attr('scope', 'col')
		:attr('data-sort-type', 'number')
		:wikitext('ID')

	row:tag('th')
		:attr('scope', 'col')
		:attr('data-sort-type', 'text')
		:wikitext('Spell Name')

	for _, spell in ipairs(spells) do
		local row = table:tag('tr')

		row:tag('td')
			:wikitext(spell.ID)

		row:tag('td')
			:wikitext(frame:expandTemplate { title = 'SpellTooltip', args = { spell_name = spell.Name } })
	end

	return tostring(table)
end


function p.Gallery(frame)
	if frame == mw.getCurrentFrame() then
		args = frame:getParent().args
	else
		args = frame
	end
	local spells = SpellList()
	if args.accumulated then
		KeepOnlyAccumulated(spells)
	end
	if args.persistent then
		KeepOnlyPersistent(spells)
	end
	if args.charging then
		KeepOnlyCharging(spells)
	end
	FilterByClass(spells, args.class)
	FilterBySchool(spells, args.school)
	FilterByAdditionalCost(spells, args.add_cost)
	FilterByBehavior(spells, args.behavior)
	FilterByPriority(spells, args.priority)

	local gallery = ''

	for i, spell in pairs(spells) do
		gallery = gallery .. frame:expandTemplate {
			title = 'SpellTooltip',
			args = { spell.Name }
		}
	end

	local galleryDiv = mw.html.create('div')
	galleryDiv:addClass('spell-gallery')
		:wikitext(gallery)
		:tag('div')

	return tostring(galleryDiv)
end


return p
