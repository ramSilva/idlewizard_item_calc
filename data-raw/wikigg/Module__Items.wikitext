    local list = table_head
    for _, item in pairs(ItemList()) do
        local tier_count = table.getn(item.Tiers)
        list = list .. table_row:format(
            tier_count, item.Name, item.Name,
            tier_count, item.Name,
            tier_count, item.Slot,
            tier_count, SetInfo(item.Set),
            tier_count, Requirements(item)
        )
        for i, tier in pairs(item.Tiers) do
            list = list .. tier_row:format(
                item.Quality + i - 1, colors[item.Quality + i - 1], qualities[item.Quality + i - 1],
                tier.Cost and tier.Cost[1] or '-',
                tier.Cost and tier.Cost[2] or '-',
                tier.Cost and tier.Cost[3] or '-',
                tier.Cost and tier.Cost[4] or '-',
                Description(tier)
            )
            if i < tier_count then
                list = list .. "|-\n"
            end
        end
    end
    return list .. "|}"
end

