---------------------------------------- Item List
function ItemList()
    local items = {}
    for item_name, item in pairs(all_items) do
        item.Name = item_name
        table.insert(items, item)
    end
    table.sort(items, function(a, b) return a.Slot == b.Slot and a.Name < b.Name or a.Slot < b.Slot end)
    return items
end

