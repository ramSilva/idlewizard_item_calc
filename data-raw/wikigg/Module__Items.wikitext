function p.QualityTable(frame)
    local item_name = frame.args[1]

    local item = all_items[item_name]
    local rows = {}
    
    for key, tier in pairs(item.Tiers) do
         rows[#rows+1] = qualities_row:format(
            colors[   item.Quality + key - 1], 
            qualities[item.Quality + key - 1],

            tier.Cost and tier.Cost[1] or '-',
            tier.Cost and tier.Cost[2] or '-',
            tier.Cost and tier.Cost[3] or '-',
            tier.Cost and tier.Cost[4] or '-',
            Description(tier)
         )
    end
    
    return frame:preprocess(
        qualities_headers ..
        table.concat(rows) ..
        '|}'
    )
