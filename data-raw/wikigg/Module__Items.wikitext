---------------------------------------- Utility
function TokenizeItemCode(code)
	
		-- no trailing comma allowed
	if code:sub(-1) == ";" then
		return error("Invalid item set code, last item entry has a trailing ';'")
	end
	
	local item_id = nil
	--tokenize and grab relevant substrings
	local items = {}
	for id in (code .. ";"):gmatch("([-]?%d+);") do
		table.insert(items, id)
	end
	return items
end

local itempreset_template = [=[<td>{{ItemIcon | item_name=%s | item_quality=%s}}</td>]=]

function p.FromCodes(frame)
	local result = ""
	local itempreset_code = frame.args[1]

	if itempreset_code == nil then
		for i = 1, 20 do
			result = result .. string.format(itempreset_template, '', 'Legendary')
		end
	else
		local itemstokenized = TokenizeItemCode(itempreset_code)
		for i = 1, 20 do
			result = result .. ItemLookup(itemstokenized[i], frame)
		end
	end
	
	return result
end

function ItemLookup(id, frame)
    local name = ''
    local quality = 'Legendary'
	
	if id ~= nil then
		name = data.IDs[tonumber(id)]
		if name ~= '' then
			if all_items[name].Quality == 6 then
				quality = 'Unique'
			end
		end
	end
	
	return '<td>' .. frame:expandTemplate{ title = 'ItemIcon', args = { item_name = name, item_quality = quality }
	} .. '</td>'

end

function p.ItemLookup(frame)
    local id = frame.args[1]
    local name = ''
    
    if id ~= nil then
        name = data.IDs[tonumber(id)]
    end
    
    return string.format(name)
end

function p.IDLookup(frame)
	local name = frame.args[1]
	local result = '-1'
	if name ~= '' then
		result = all_items[name].ID
	end
	return result
end

---------------------------------------- ItemSet (aka Set Info for templates)
function p.ItemSet(frame)
	local args = frame.args
    if not args.set or args.set == "" then
        args = frame:getParent().args
    end
    
    local set = args.set
    
    if set == nil or set == "" or all_sets == nil or all_sets[set] == nil then
        return "-"
    end
    
    return SetInfo(set)
end

function p.IDList(frame)
    local items = ItemList()

    local function createTable(title)
        local table = mw.html.create('table')
            :addClass('sortable')
            :addClass('wikitable')

        local header = table:tag('tr')

        header:tag('th')
            :attr('colspan', '2')
            :wikitext(title)

        local row = table:tag('tr')

        row:tag('th')
            :attr('scope', 'col')
            :attr('data-sort-type', 'number')
            :wikitext('ID')

        row:tag('th')
            :attr('scope', 'col')
            :attr('data-sort-type', 'text')
            :wikitext('Item Name')

        return table
    end

    local table = createTable('Items')
    local no_id_table = createTable('Items without ID')

    for _, item in ipairs(items) do
        local id = tonumber(item.ID)
        local target = id and table or no_id_table

        local row = target:tag('tr')

        row:tag('td')
            :wikitext(id or '')

        row:tag('td')
            :wikitext(frame:expandTemplate{
                title = 'ItemTooltip',
                args = { item_name = item.Name }
            })
    end

    return tostring(table) .. tostring(no_id_table)
end


return p
