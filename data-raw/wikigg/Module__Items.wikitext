local link_patterns = {}
link_patterns['Criticals'] = {'[Cc]rit [Rr]ating', '[Cc]ritical [Rr]ating'}
link_patterns['Experience'] = {'[Ee]xperience', '[Ll]evel'}
link_patterns['Idle_Mode'] = {'[Ii]dle [Bb]onus'}
link_patterns['Mysteries'] = {'[Mm]ysteries'}
link_patterns['Void_Entities'] = {'[Vv]oid [Mm]ana', '[Vv]oid [Ee]ntities'}
link_patterns['Chronomancer'] = {'[Cc]ompressed [Tt]ime'}
link_patterns['Temporal_Distortion'] = {'[Tt]ime [Dd]istortion'}
link_patterns[':Category:Evocation_Spells'] = {'[Ee]vocations?'}
link_patterns[':Category:Incantation_Spells'] = {'[Ii]ncantations?'}
link_patterns[':Category:Summoning_Spells'] = {'[Ss]ummon', '[Ss]ummoning'}
link_patterns[':Category:Accumulated_Spells'] = {'[Aa]ccumulated [Ss]pells?'}

---------------------------------------- Item Count
function p.ItemCount()
    local c = 0
    for i in pairs(all_items) do
        c = c + 1
    end
    return c
end

---------------------------------------- Set Info
local set_tooltip = "<span class=\"advanced-tooltip\" style=\"background:#1a1f21; border-bottom:1px dotted;text-decoration:none\">%s<div class=\"tooltip-contents\">%s</div></span>"

function SetInfo(set)
    if set == nil then
        return "-"
    end
    local set_info = ""
    for slot, item in pairs(all_sets[set].Items) do
        set_info = set_info .. "[[File:Item " .. item .. ".png|32px]] " .. item .. " (" .. slot:gsub("2$", "") .. ")<br>"
    end
    for i, tier in ipairs(all_sets[set].Tiers) do
        set_info = set_info .. "<br>" .. i + 1 .. " - " .. tier.Desc
    end
    return set_tooltip:format(set, set_info)
end

---------------------------------------- Requirements
function Requirements(item)
    if next(item.Requirements) == nil then
        return "None"
    end
    local requirements = {}
    for attribute, value in pairs(item.Requirements) do
        table.insert(requirements, value .. " " .. attribute)
    end
    return table.concat(requirements, " ")
end
-- New function made for use with tooltip,will refactor later
function RequirementsList(item)
    local reqs = {}

    if next(item.Requirements) == nil then
        return reqs -- return empty table
    end

    for attribute, value in pairs(item.Requirements) do
    	
    	local abbr = string.sub(attribute, 1, 3):upper()

			if abbr == "SPE" then
			    abbr = "SPC"
			end

		table.insert(reqs, value .. " " .. abbr)
    	
    end

    return reqs
end

---------------------------------------- Description
function Description(tier)
    local desc = tier.Desc
    for link, patterns in pairs(link_patterns) do
        for _, pat in ipairs(patterns) do
            local a, b = string.find(desc, pat)
            if a then
                desc = desc:sub(1, a - 1) .. '[[' .. link .. '|' .. desc:sub(a, b) .. ']]' .. desc:sub(b + 1, string.len(desc))
                break
            end
        end
    end
    return desc
end

------------------------------------ Tooltip Decription
function Descriptiontt(desc)
    if not desc or desc:match("^%s*$") then 
        return desc or ""
    end

    -- Skip parsing and return desc (original full text) if there's <sup> or formula-like characters (* or /)
    if desc:match("<sup>") or desc:match("[%*/]") then
        return desc
    end

    local stats = {}
    local stat_count = 0

    -- Count stat-like patterns: (Name) + (number/percentage), if it finds a pattern it detects stat count as +1
    for _ in desc:gmatch("([A-Za-z][%a%s'%-%(%)]+)%s+([%+%-]?[%d%.%%%(%)]+)") do
        stat_count = stat_count + 1
    end

    -- If it counts 0 or 1 stat count, return original desc text, usually this fits the description for weapons where we want the full text. 
    if stat_count < 2 then
        return desc
    end

    -- Parse and capitalize stats
    for part in desc:gmatch("[^,]+") do
        part = part:match("^%s*(.-)%s*$") -- trim spaces

        for stat, value in part:gmatch("([A-Za-z][%a%s'%-%(%)]+)%s+([%+%-]?[%d%.%%%(%)]+)") do
            stat = stat:gsub("(%a)([%w_']*)", function(first, rest)
                return first:upper() .. rest:lower()
            end)
            table.insert(stats, stat .. " " .. value)
        end
    end

    if #stats == 0 then
        return desc
    end

    return stats
end


---------------------------------------- Tooltip
function p.Tooltip(frame)
    local item_name = frame.args[1]
    local item = all_items[item_name]
    
    if item == nil then
        mw.log(item_name)
        return "''Item tooltip data not found for \"" .. item_name .. "\". Check the parameter ''"
    end
    
    -- Root tooltip container
    -- check if the quality is to be unique or mythic for custom.css
    local qualityClass = ""
	    if qualities[item.Quality] == "Mythic" then
	    	qualityClass = "mythic"
		elseif qualities[item.Quality] == "Unique" then
		    qualityClass = "unique"
		end
    local root = mw.html.create('div')
        :addClass('tooltip item')
        :addClass(qualityClass)    
        
    local bar = root:tag('div'):addClass('tt-bar')
    local leftbar = bar:tag('div'):addClass('tt-bar-left')
    local rightbar = bar:tag('div'):addClass('tt-bar-right')
	    
		leftbar:tag('span')
		:wikitext(item.Slot)
		
		if item.Set then
			leftbar:tag('span')
			:wikitext(item.Set)
		end
		
	local item_reqs = RequirementsList(item)
		for _, req in ipairs(item_reqs) do
		    rightbar:tag('span')
		       :addClass('req')
		       :wikitext(req)
		end
    
    local item_acquisition = item.Acquisition
        if (item_acquisition == "")  or (item_acquisition == nil) then
            item_acquisition = 'Craftable'
        end
        rightbar:tag('span')
            :addClass('req')
            :wikitext(item_acquisition)
            
	local contentWrapper = root:tag('div'):addClass('tt-content-wrapper')	
	local content = contentWrapper:tag('div'):addClass('tt-content')

	    -- Title 
	    local title = content:tag('div'):addClass('tt-title')
	        :wikitext(item_name)
	        
		
		-- Icon
	   contentWrapper:tag('div')
	        :addClass('tt-icon')
	        :wikitext(string.format('[[File:Item_%s.png|64x64px]]', item_name))
    
   

        local effect = content:tag('div')
            :addClass('tt-effect')
            
        local label = effect:tag('div'):addClass('tt-label')
        label:tag('div')
            :wikitext("Max Effect")
            
            
         -- Max Effect
	    local max_tier = item.Tiers[#item.Tiers]
	    local max_desc = max_tier and max_tier.Desc or "None"
	  
	     -- Ensure desc_lines is always a table (single entries will not be tables)
		local desc_lines = Descriptiontt(max_desc)
		if type(desc_lines) ~= "table" then
	    	desc_lines = { desc_lines }
		end
		
		local info = effect:tag('div'):addClass('tt-effect-info')
		
		-- Loop for each desc line. 
		 for i = 1, #desc_lines do
        local line = desc_lines[i]
        if line and line:match("%S") then --for each line append the html into max_effect_html, it can repeat however many times it needs. 
	        info:tag('div')
	            :addClass('tt-effect-line')
	            :tag('p')
	            :wikitext(line)      
        end
		 end

        local effect1 = content:tag('div')
            :addClass('tt-enchant')
            
         local label = effect1:tag('div'):addClass('tt-label')
        label:tag('div')
            :wikitext("Enchant")
            


	    -- enchant section
	    local enchantSection = effect1:tag('div'):addClass('tt-enchant-info')
	   -- enchant text
	   
	    local enchantText = enchantSection:tag('div'):addClass('enchant-text')
	    enchantText:tag('p')
	        :wikitext(item.Enchant)
	        
	return tostring(root)
end

---------------------------------------- Infobox
local infobox_template = [=[
{{ItemInfobox
|title=%s
|icon=%s
|slot=%s
|set=%s
|requirement=%s
|quality=%s
|max_effect=%s
|enchant=%s
}}]=]

function p.Infobox(frame)
    local item_name = frame.args[1]
    local item = all_items[item_name]
    return frame:preprocess(infobox_template:format(
        item_name,
        '[[File:Item_' .. item_name .. '.png]]',
        item.Slot,
        SetInfo(item.Set),
        Requirements(item),
        qualities[item.Quality],
        Description(item.Tiers[#item.Tiers]),
        item.Enchant
    ))
end

